# Gripstock environment configuration
# Copy to .env and adjust for your local setup. Never commit real secrets.

# Core
GRIPSTOCK_ENV=development
GRIPSTOCK_DEBUG=true
GRIPSTOCK_SECRET_KEY=change-me-to-a-random-string

# Database (SQLAlchemy URL). Defaults to a local SQLite file.
GRIPSTOCK_DATABASE_URL=sqlite:///./gripstock.db

# Auth / sessions
GRIPSTOCK_SESSION_TTL_MINUTES=720
GRIPSTOCK_PASSWORD_MIN_LENGTH=10